# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Only this Telegram chat can use the bot. You can obtain the numeric chat ID
# from Telegram's getUpdates API after messaging the bot once.
TELEGRAM_CHAT_ID=123456789

# Used when running the bot directly. Compose overrides the host to `postgres`.
DATABASE_URL=postgres://jobhawk:jobhawk@localhost:5432/jobhawk?sslmode=disable

# Optional: debug, info, warn, or error (default: info).
LOG_LEVEL=info

# Daily reports run at 09:00 in this IANA timezone by default.
DAILY_RUN_HOUR=9
DAILY_TIMEZONE=America/Chicago
